<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key><string>iOS26 时间样式</string>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>基本设置</string>
            <key>footerText</key><string>修改后立即生效，无需注销。关闭开关会还原系统原始时钟。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>启用插件</string>
            <key>key</key><string>enabled</string>
            <key>defaults</key><string>com.axs.liquidclock</string>
            <key>default</key><false/>
        </dict>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>时钟尺寸</string>
            <key>footerText</key><string>宽度越大字形越舒展，高度越大字形越修长；高度不足时优先调这一项。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsLiquidClockSliderCell</string>
            <key>label</key><string>字号倍数</string>
            <key>key</key><string>clockScale</string>
            <key>defaults</key><string>com.axs.liquidclock</string>
            <key>default</key><real>1.7</real>
            <key>min</key><real>1.0</real>
            <key>max</key><real>2.4</real>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsLiquidClockSliderCell</string>
            <key>label</key><string>字形宽度</string>
            <key>key</key><string>fontWidth</string>
            <key>defaults</key><string>com.axs.liquidclock</string>
            <key>default</key><real>88.0</real>
            <key>min</key><real>60.0</real>
            <key>max</key><real>100.0</real>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsLiquidClockSliderCell</string>
            <key>label</key><string>字形高度</string>
            <key>key</key><string>fontHeight</string>
            <key>defaults</key><string>com.axs.liquidclock</string>
            <key>default</key><real>220.0</real>
            <key>min</key><real>100.0</real>
            <key>max</key><real>500.0</real>
        </dict>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>字体形态</string>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsLiquidClockSliderCell</string>
            <key>label</key><string>字重</string>
            <key>key</key><string>fontWeight</string>
            <key>defaults</key><string>com.axs.liquidclock</string>
            <key>default</key><real>500.0</real>
            <key>min</key><real>100.0</real>
            <key>max</key><real>900.0</real>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsLiquidClockSliderCell</string>
            <key>label</key><string>柔度</string>
            <key>key</key><string>fontSoftness</string>
            <key>defaults</key><string>com.axs.liquidclock</string>
            <key>default</key><real>70.0</real>
            <key>min</key><real>0.0</real>
            <key>max</key><real>100.0</real>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>圆体字形</string>
            <key>key</key><string>roundedFont</string>
            <key>defaults</key><string>com.axs.liquidclock</string>
            <key>default</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>液态效果</string>
            <key>footerText</key><string>液态数字字体使用内置可变字体；未启用时退回系统圆体。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>液态数字字体</string>
            <key>key</key><string>liquidFont</string>
            <key>defaults</key><string>com.axs.liquidclock</string>
            <key>default</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsLiquidClockSliderCell</string>
            <key>label</key><string>通透度</string>
            <key>key</key><string>clockOpacity</string>
            <key>defaults</key><string>com.axs.liquidclock</string>
            <key>default</key><real>0.8</real>
            <key>min</key><real>0.3</real>
            <key>max</key><real>1.0</real>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>播放音乐时收缩</string>
            <key>key</key><string>shrinkOnMusic</string>
            <key>defaults</key><string>com.axs.liquidclock</string>
            <key>default</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>footerText</key><string>by 鱼教兽</string>
        </dict>
    </array>
</dict>
</plist>
