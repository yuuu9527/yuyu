#!/bin/sh
# iOS26 液态时钟（独立版）——只开锁屏时钟，其余全部关闭
# 兼容 roothide(隐根) / rootless / rootful
set +e

DOMAIN="dylv.liquidassprefs"
PLIST="/var/mobile/Library/Preferences/${DOMAIN}.plist"

DEF=""
for c in "${JBROOT:-/var/jb}/usr/bin/defaults" "/var/jb/usr/bin/defaults" "/usr/bin/defaults"; do
    if [ -x "$c" ]; then DEF="$c"; break; fi
done
[ -z "$DEF" ] && DEF="$(command -v defaults 2>/dev/null)"
[ -z "$DEF" ] && exit 0

[ -f "$PLIST" ] && cp -p "$PLIST" "${PLIST}.bak.$(date +%s)" 2>/dev/null

w() { "$DEF" write "$DOMAIN" "$1" "$2" "$3" >/dev/null 2>&1; }

# ── 只保留锁屏液态时钟（面板里能看到的项）──
w Global.Enabled               -bool  true
w Lockscreen.Clock             -bool  true
w Clock.Blur                   -bool  true
w Clock.FPS                    -int   60
w Clock.BezelWidth             -float 2.0
w Clock.VariableFont.Enabled   -bool  true
w Clock.VariableFont.SizeScale -float 1.0
w Clock.VariableFont.Weight    -float 0.4
w Clock.VariableFont.Softness  -float 0.5

# ── 与时钟无关的功能：一律关闭 ──
for k in \
  Island.Gradient.Enabled Island.Scrim.Enabled \
  Banner.Gradient.Enabled Notification.Gradient.Enabled \
  Alerts.Gradient.Enabled ContextMenu.Gradient.Enabled \
  NavigationBar.TopFade.Enabled LockWidget.Enabled \
  Lockscreen.Passcode \
  DateRow.Enabled DateRow.Gradient.Enabled DateRow.Gradient.Breathe \
  Clock.Gradient.DateRow Lockscreen.Clock.DateFormat.Enabled \
  Keyboard.CustomFont.Enabled Keyboard.Overhang \
  GlobalControls.Segmented.Enabled GlobalControls.Sliders.Enabled GlobalControls.Switches.Enabled \
  SettingsControls.Enabled SettingsControls.SearchBar.Enabled \
  Specular.Motion.Enabled CustomViews.Enabled \
  Debug.Logging.Enabled Debug.LiveLog.Enabled Debug.ClockDiag.Enabled
do
    w "$k" -bool false
done

# 灵动岛：彻底关掉（screen 混合与遮罩都会让岛轮廓内缩/发雾）
w Island.ScreenBlend -int 0
w Island.Scrim.Alpha -float 0

# 清掉岛的残留状态缓存，避免旧状态继续被套用
rm -f /var/mobile/Library/Accessibility/liquidglass-island-state.bin      2>/dev/null
rm -f /var/mobile/Library/Accessibility/liquidglass-island-wallpaper.bin  2>/dev/null

chown mobile:mobile "$PLIST" 2>/dev/null
chmod 644 "$PLIST" 2>/dev/null

killall -9 cfprefsd    >/dev/null 2>&1
sleep 1
killall -9 SpringBoard >/dev/null 2>&1

exit 0
